# ======================================================
# AMINE ACADEMY — Environment Variables
# نسخ هذا الملف إلى .env.local وملء القيم الحقيقية
# ======================================================

# قاعدة البيانات (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
# بديل (Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# المصادقة — openssl rand -hex 32
AUTH_SECRET=replace-with-64-char-random-string

# كلمة مرور لوحة الإدارة
ADMIN_PASSWORD=replace-with-strong-admin-password

# البريد الإلكتروني
GMAIL_USER=amine.hamdi.pro25@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RESEND_API_KEY=re_xxxxx

# الذكاء الاصطناعي
ANTHROPIC_API_KEY=sk-ant-xxx

# Cron Jobs
CRON_SECRET=replace-with-random-secret

# SEO & Public
NEXT_PUBLIC_BASE_URL=https://amine-academy.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# إشعارات المشرف
NOTIFY_EMAIL=amine.hamdi.pro25@gmail.com

# التحقق من Google
GOOGLE_SITE_VERIFICATION=xxx

# Daily.co (مكالمات الفيديو)
DAILY_API_KEY=

# ======================================================
# Pusher — المزامنة اللحظية (Real-time)
# اختياري: بدونها تعمل المنصة بالاستطلاع كل ثانية.
# معها تصبح كل التفاعلات فورية (~100ms) بدل ثانية كاملة.
# أنشئ تطبيقاً مجانياً على https://dashboard.pusher.com ثم انسخ:
#   App ID / Key / Secret / Cluster  →  الأربعة أدناه
# ملاحظة: Key و Cluster مكرّران بادئة NEXT_PUBLIC_ ليصلا للمتصفح.
# ======================================================
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# واتساب
NEXT_PUBLIC_WHATSAPP_NUMBER=21600000000

# البريد التواصل العام
NEXT_PUBLIC_CONTACT_EMAIL=contact@amine-academy.com
