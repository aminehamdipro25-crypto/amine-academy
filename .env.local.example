KV_REST_API_TOKEN=

# المصادقة — openssl rand -hex 32
AUTH_SECRET=replace-with-64-char-random-string

# البريد الإلكتروني
GMAIL_USER=amine.hamdi.pro25@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
